* text=auto eol=lf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
# Preserve whitespace in verbatim third-party licenses and font metadata notices.
cover_letters/OpenFonts/fonts/*/OFL.txt whitespace=-blank-at-eol
cover_letters/OpenFonts/fonts/*/NOTICE.txt whitespace=-blank-at-eol
